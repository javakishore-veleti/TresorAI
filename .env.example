# Copy to .env (or .envrc) and fill in. Both files are gitignored.

# --- Generative AI ---
# Get a key at https://aistudio.google.com/apikey  (free tier is generous for portfolio use)
GEMINI_API_KEY=

# Optional alias the Google SDK also accepts
GOOGLE_API_KEY=

# --- Storage adapter (ADR-0015) — pick one provider ---
TAI_STORAGE_PROVIDER=gcs               # gcs | s3 | azure
TAI_STORAGE_BUCKET=tresorai-datasets
TAI_STORAGE_PREFIX=datasets/

# Provider-specific extras (only the active provider's vars need to be set)
TAI_GCS_PROJECT=
TAI_AWS_REGION=us-east-1
TAI_AZURE_ACCOUNT=
TAI_AZURE_CONTAINER=datasets

# --- Local dataset cache override (defaults to $HOME/runtime_data/tresorai/datasets/) ---
# TAI_DATASETS_ROOT=/Volumes/external-ssd/tresorai/datasets

# --- Postgres (matches docker-compose) ---
DATABASE_URL=postgresql://tresorai:tresorai@localhost:5432/tresorai

# --- Kafka (matches docker-compose) ---
KAFKA_BOOTSTRAP=localhost:9092

# --- Redis (matches docker-compose) ---
REDIS_URL=redis://localhost:6379/0
