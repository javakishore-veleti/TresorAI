  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "start": "bash scripts/dev-up.sh",
    "stop":  "bash scripts/dev-down.sh"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  }
}
