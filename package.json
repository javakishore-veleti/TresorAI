{
  "name": "tresorai",
  "version": "0.0.1",
  "private": true,
  "description": "TrésorAI monorepo. Two commands you remember: 'npm run setup' once, 'npm start' every day. Data downloads run from the admin portal -> Airflow, not the CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/javakishore-veleti/TresorAI"
  },
  "engines": {
